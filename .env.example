PORT=8080
APP_ENV=development

# Configuración de conexión a la base de datos (usada por la app local)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433
DB_SSLMODE=disable

# Nombres de bases de datos por entorno
# DB_NAME_DEV debe coincidir con POSTGRES_DB de docker/.env (metrics_db por defecto)
DB_NAME_DEV=metrics_db
DB_NAME_TEST=metrics_db_test
DB_NAME_PROD=metrics_db

# Autenticación JWT (US-10). JWT_SECRET es obligatoria: sin ella la
# aplicación no arranca. Cambiala por un valor secreto en cada entorno.
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
# Vigencia de cada token. Formato time.ParseDuration (opcional, 24h por defecto).
JWT_EXPIRY=24h
